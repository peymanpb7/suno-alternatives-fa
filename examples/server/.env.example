# Example environment variables for the Suno proxy
# Fill these with your own values (do NOT commit the real file with secrets)

# The Suno API URL that accepts prompt -> audio. Check Suno docs for exact endpoint.
SUNO_API_URL=https://api.suno.ai/v1/generate

# Your Suno API token (keep secret)
SUNO_API_TOKEN=replace_with_your_suno_token

# Shared secret for clients (simple protection); set to a random string
PROXY_SECRET=replace_with_a_random_secret
